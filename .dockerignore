# Allowlist: start by ignoring every file and folder in the project
*

# Let back in the runtime package list (used by pip in the Dockerfile)
!requirements-api.txt

# Let back in the API code only (not training scripts in src/)
!src/api/

# Even inside allowed folders, skip Python bytecode caches (rebuilt automatically)
**/__pycache__
**/*.pyc

# models/ and data/serving/ are no longer sent to Docker: the image is code only (Day 17)