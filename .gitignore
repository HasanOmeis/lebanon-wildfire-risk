# ignore the virtual environment folder, it's huge and rebuilt from requirements.txt
.venv/

# ignore the .env file so your secret API key never reaches GitHub
.env

# ignore Python's compiled cache files
__pycache__/

# ignore any compiled Python file anywhere
*.pyc

# ignore Jupyter's auto-saved notebook backups
.ipynb_checkpoints/

# ignore everything inside the data folders (data is downloaded, not stored in Git)
data/raw/*
data/processed/*
data/external/*

# but keep the placeholder files so the folders still exist on GitHub
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# ignore saved model files (they're large and re-trained)
models/*

# but keep the models placeholder file
!models/.gitkeep

# ignore MLflow's local experiment-tracking folders
mlruns/
mlartifacts/

# ignore Optuna and other local database files
*.db

# ignore VS Code's personal settings folder
.vscode/

# ignore generated charts by default (the check scripts rebuild them)
reports/*
# but let Git look inside the figures folder
!reports/figures/
# ignore everything in the figures folder by default
reports/figures/*
# except the numbered EDA charts (01_..., 02_...), which the README shows
!reports/figures/0*_*.png
.pytest_cache/
# MLflow (local experiment tracking)
mlflow.db
mlruns/
!reports/baseline_results.csv
!reports/model_results.csv
# Day 10 validation results shown in the README
!reports/validation_*.csv
!reports/validation_config.json
!reports/validation_comparison.png
# Day 11 tuning and final test results shown in the README
!reports/tuning_*.csv
!reports/final_test*.csv
!reports/figures/1*_*.png
# Day 12 SHAP results shown in the README
!reports/shap_importance.csv
!reports/figures/shap_*.png