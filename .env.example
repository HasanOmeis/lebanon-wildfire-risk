# copy this file to .env and fill in your own values (never commit .env)

# NASA FIRMS API key (fire downloads)
FIRMS_MAP_KEY=your_key_here

# shared secret for POST /reload (make one with: python -c "import secrets; print(secrets.token_urlsafe(24))")
RELOAD_TOKEN=your_random_token_here

# where the daily pipeline finds the running API
API_URL=http://127.0.0.1:8000