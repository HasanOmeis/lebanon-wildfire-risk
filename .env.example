# copy this file to .env and fill in your own values (never commit .env)

# NASA FIRMS API key (fire downloads)
FIRMS_MAP_KEY=your_key_here

# shared secret for POST /reload (make one with: python -c "import secrets; print(secrets.token_urlsafe(24))")
RELOAD_TOKEN=your_random_token_here

# where the daily pipeline finds the running API
API_URL=http://127.0.0.1:8000

# Hugging Face write token for the daily upload (huggingface.co/settings/tokens, type Write; laptop only)
HF_TOKEN=hf_your_token_here

# the Hugging Face dataset repo that holds the model and serving files
HF_REPO=your-username/lebanon-fire-radar-serving

# the live API, reloaded by the pipeline after each upload
LIVE_API_URL=https://your-service.onrender.com